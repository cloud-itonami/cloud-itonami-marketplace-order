{
  "name": "cloud-itonami-marketplace-order",
  "main": "dist/worker.js",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true }
  // NO D1 binding: this host no longer embeds a storage provider. It talks to
  // kotobase.net through kotoba-lang/kotobase-client, so authorization, tenant
  // isolation and replay protection are the service's, not this Worker's.
  //
  // Secrets (`wrangler secret put`), never placed here:
  //   KOTOBASE_SECRET_KEY  the actor's own Ed25519 seed (base64, 32 bytes).
  //                        The client mints a CACAO per request from it; the
  //                        key-derived graph IS this actor's namespace, so no
  //                        token hand-off is involved (build-actor skill).
  //   ORDER_WRITE_TOKEN    gates POST /orders and /admin/seed. Reads are open.
}
