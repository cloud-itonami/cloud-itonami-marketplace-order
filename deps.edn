{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). This repo
 ;; Pinned by git coordinate. This repo IS standalone and CI checks it out
 ;; alone, so a sibling path never resolved there -- the classpath failed to
 ;; build before any test ran.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.com-junkawasaki/langgraph-clj
        {:git/url "https://github.com/kotoba-lang/langgraph.git"
         :git/sha "577a59a9d5eb3ef90b81342f4673973f481ff7f4"}
        ;; the multi-seller order contract (a parent over per-seller okaimono
        ;; sub-orders), the catalog offers it prices from, and the seller
        ;; credential it reads. This actor composes the other actors'
        ;; outputs; it re-implements none of their rules.
        io.github.kotoba-lang/marketplace
        {:git/url "https://github.com/kotoba-lang/marketplace.git"
         :git/sha "2bdd9b6bc7876afa5e081f66f9ed2deb24d4b648"}
        ;; The kotobase.net client, for the HOST half only
        ;; (orderops.edge.worker): q / pull / datoms / transact with a
        ;; per-request CACAO. This replaced a direct kotobase-storage-d1
        ;; embedding that bypassed the service's authorization entirely and
        ;; hand-rolled a query stub in place of q/pull.
        io.github.kotoba-lang/kotobase-client
        {:git/url "https://github.com/kotoba-lang/kotobase-client.git"
         :git/sha "f88a46930e4209c4346c0ef78f3795a948bf73b6"}}
 :aliases
 {;; This alias held an :override-deps entry for the retired coordinate
  ;; io.github.com-junkawasaki/langchain-clj. langgraph declares the same
  ;; library as io.github.kotoba-lang/langchain, so the entry matched no
  ;; node in the resolved tree and never reached the classpath -- verified
  ;; with `clojure -Stree`/-Spath, unchanged before and after removal.
  :dev {}
  :component
  {:extra-deps {io.github.kotoba-lang/compiler
                {:git/url "https://github.com/kotoba-lang/compiler.git"
                 :git/sha "c8a9f7ef16ad8c605749e56c3bc4c73607545bec"}
                io.github.kotoba-lang/kotoba-component
                {:git/url "https://github.com/kotoba-lang/kotoba-component.git"
                 :git/sha "99275e24570265ecba91fd4026d993c135a02362"}}
   :main-opts ["-m" "kotoba.compiler.cli"]}
  :run {:main-opts ["-m" "orderops.sim"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.kotoba-lang/compiler
                      {:git/url "https://github.com/kotoba-lang/compiler.git"
                       :git/sha "c8a9f7ef16ad8c605749e56c3bc4c73607545bec"}
                      io.github.kotoba-lang/kotoba-component
                      {:git/url "https://github.com/kotoba-lang/kotoba-component.git"
                       :git/sha "99275e24570265ecba91fd4026d993c135a02362"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
